# Copy to .env for Docker Compose. Never commit the populated file.
DB_PASSWORD=replace-with-a-unique-long-random-password
BOOTSTRAP_PASSWORD=replace-with-a-different-unique-12-plus-character-password
BOOTSTRAP_MD_PASSWORD=replace-with-another-unique-md-read-only-password
BOOTSTRAP_EMAIL=admin@electrogroup.test
DISPATCH_SITE=electro
# Use a separate Compose project, volume and credentials for Aromazon: DISPATCH_SITE=aromazon
# Native .NET configuration uses environment names below:
# DispatchSite=electro (or aromazon, with its own database)
# ConnectionStrings__Dispatch=Host=127.0.0.1;Port=5432;Database=dispatch;Username=dispatch;Password=...
# MigrateOnStart=true
# BootstrapPassword=...
# BootstrapEmail=admin@electrogroup.test
# AllowedOrigins=http://127.0.0.1:5173
# ASPNETCORE_URLS=http://127.0.0.1:5080
# Cloud PostgreSQL may instead provide DATABASE_URL=postgresql://...?...sslmode=require

# AROMAZEN production API only: set server-side AromazenTallyCompany to the exact company exported by its own Tally installation.
